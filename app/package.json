{
  "name": "contexthub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vinext build && node scripts/prepare-server-build.mjs",
    "start": "node scripts/run-production.mjs",
